{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": false,
    "useUnknownInCatchVariables": true,
    "verbatimModuleSyntax": false,
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    // #302: per-package build-info cache (${configDir}, TS 5.5+) so `tsc --noEmit`
    // (typecheck) and build both skip unchanged files instead of re-checking the whole
    // program every `mise run check` — already gitignored (.turbo/, *.tsbuildinfo).
    "incremental": true,
    "tsBuildInfoFile": "${configDir}/.turbo/tsbuildinfo/tsconfig.tsbuildinfo",
    "types": ["node"]
  }
}
