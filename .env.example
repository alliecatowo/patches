# Copy to .env for local development. Never commit .env.
NODE_ENV=development
LOG_LEVEL=debug

# PostgreSQL (matches infra/compose/docker-compose.yml)
DATABASE_URL=postgres://patches:patches@127.0.0.1:5432/patches
TEST_DATABASE_URL=postgres://patches:patches@127.0.0.1:5432/patches_test
# Optional: apps/server's integration tests use their own database so they never race
# `database`'s dropDatabase() calls against `patches_test`. Falls back to
# TEST_DATABASE_URL with the database name swapped to patches_test_server when unset
# (see apps/server/vitest.integration.config.mts, docs/operations/ci.md).
# TEST_DATABASE_URL_SERVER=postgres://patches:patches@127.0.0.1:5432/patches_test_server
# Optional: packages/testkit's own integration suite likewise uses its own database
# (B-012), named with a _test suffix (not _test_testkit infix) because
# createTestDataSource()'s guard requires that. Falls back to TEST_DATABASE_URL with the
# database name swapped when unset (see packages/testkit/vitest.config.ts).
# TEST_DATABASE_URL_TESTKIT=postgres://patches:patches@127.0.0.1:5432/patches_testkit_test

# gRPC server
GRPC_HOST=127.0.0.1
GRPC_PORT=50051
PUBLIC_ORIGIN=http://localhost:50051
# Attaches grpc.reflection.v1alpha.ServerReflection so `grpcurl -plaintext 127.0.0.1:50051
# list` works without shipping .proto files (B-006). Dev-only — leave unset/false in
# production.
GRPC_REFLECTION=true

# Auth. Generate the Ed25519 signing keypair with: pnpm keys:generate
# (values are base64-encoded PEM: PKCS#8 private, SPKI public).
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
INVITE_ONLY=true
# Canonical domain of this node. Bound into every session and into the SSH login
# challenge blob, so a signature captured here cannot be replayed against another node.
NODE_DOMAIN=localhost
# Token lifetimes, in seconds (15 minutes / 30 days).
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000
# Argon2id cost. Defaults are the OWASP baseline (19 MiB, t=2, p=1); benchmark on the
# deployment hardware before raising them.
# ARGON2_MEMORY_KIB=19456
# ARGON2_TIME_COST=2
# ARGON2_PARALLELISM=1

# Email: console | smtp | resend
EMAIL_PROVIDER=smtp
EMAIL_FROM="Patches <no-reply@patches.local>"
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
RESEND_API_KEY=

# Object storage (Cloudflare R2 in prod; MinIO locally via `mise run compose -- up -d` —
# `minio`/`minio-init` are default-on, ADR 0015). R2_ACCOUNT_ID is R2-only (used to derive
# the account's endpoint); leave it unset for MinIO, which uses R2_ENDPOINT directly.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=patches
R2_SECRET_ACCESS_KEY=patchespatches
R2_BUCKET=patches-media
R2_ENDPOINT=http://127.0.0.1:9000
# MinIO needs path-style addressing; R2 also accepts it. Leave default unless pointed at a
# virtual-hosted-style-only S3 provider.
R2_FORCE_PATH_STYLE=true
R2_REGION=auto

# Media limits (spec §28) and presigned-URL lifetimes (spec §30, §32). Defaults shown.
# MEDIA_MAX_BYTES=10485760
# MEDIA_MAX_PIXELS=20000000
# MEDIA_PRESIGN_PUT_TTL_SECONDS=300
# MEDIA_PRESIGN_GET_TTL_SECONDS=600
# MEDIA_PENDING_UPLOAD_EXPIRY_MINUTES=60

# TUI (client)
PATCHES_SERVER=127.0.0.1:50051
PATCHES_INSECURE=true
