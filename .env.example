# Copy to .env for local development. Never commit .env.
NODE_ENV=development
LOG_LEVEL=debug

# PostgreSQL (matches infra/compose/docker-compose.yml)
DATABASE_URL=postgres://patches:patches@127.0.0.1:5432/patches
TEST_DATABASE_URL=postgres://patches:patches@127.0.0.1:5432/patches_test
# Optional: apps/server's integration tests use their own database so they never race
# `database`/`testkit`'s dropDatabase() calls against `patches_test`. Falls back to
# TEST_DATABASE_URL with the database name swapped to patches_test_server when unset
# (see apps/server/vitest.integration.config.mts, docs/operations/ci.md).
# TEST_DATABASE_URL_SERVER=postgres://patches:patches@127.0.0.1:5432/patches_test_server

# gRPC server
GRPC_HOST=127.0.0.1
GRPC_PORT=50051
PUBLIC_ORIGIN=http://localhost:50051

# Auth (generate with: pnpm keys:generate)
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
INVITE_ONLY=true

# Email: console | smtp | resend
EMAIL_PROVIDER=smtp
EMAIL_FROM="Patches <no-reply@patches.local>"
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
RESEND_API_KEY=

# Object storage (Cloudflare R2 in prod; MinIO locally via `mise run compose -- --profile media up -d`)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=patches
R2_SECRET_ACCESS_KEY=patchespatches
R2_BUCKET=patches-media
R2_ENDPOINT=http://127.0.0.1:9000

# TUI (client)
PATCHES_SERVER=127.0.0.1:50051
PATCHES_INSECURE=true
