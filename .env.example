# Copy to .env for local development. Never commit .env.
NODE_ENV=development
LOG_LEVEL=debug

# PostgreSQL (matches infra/compose/docker-compose.yml)
DATABASE_URL=postgres://patches:patches@127.0.0.1:5432/patches
TEST_DATABASE_URL=postgres://patches:patches@127.0.0.1:5432/patches_test
# Optional: apps/server's integration tests use their own database so they never race
# `database`'s dropDatabase() calls against `patches_test`. Falls back to
# TEST_DATABASE_URL with the database name swapped to patches_test_server when unset
# (see apps/server/vitest.integration.config.mts, docs/operations/ci.md).
# TEST_DATABASE_URL_SERVER=postgres://patches:patches@127.0.0.1:5432/patches_test_server
# Optional: apps/admin's integration suite likewise uses its own database, named
# patches_test_admin, same reasoning as TEST_DATABASE_URL_SERVER above (see
# apps/admin/vitest.integration.config.mts, docs/operations/ci.md).
# TEST_DATABASE_URL_ADMIN=postgres://patches:patches@127.0.0.1:5432/patches_test_admin
# Optional: packages/testkit's own integration suite likewise uses its own database
# (B-012), named with a _test suffix (not _test_testkit infix) because
# createTestDataSource()'s guard requires that. Falls back to TEST_DATABASE_URL with the
# database name swapped when unset (see packages/testkit/vitest.config.ts).
# TEST_DATABASE_URL_TESTKIT=postgres://patches:patches@127.0.0.1:5432/patches_testkit_test

# gRPC server
GRPC_HOST=127.0.0.1
GRPC_PORT=50051
PUBLIC_ORIGIN=http://localhost:50051
# Attaches grpc.reflection.v1alpha.ServerReflection so `grpcurl -plaintext 127.0.0.1:50051
# list` works without shipping .proto files (B-006). Dev-only — leave unset/false in
# production.
GRPC_REFLECTION=true

# Always-on HTTP listener (ADR 0016): serves GET /healthz and the Connect edge at
# /patches.v1.* (web/RN clients — same schema as gRPC, proxied to it over loopback). Also
# serves the federation HTTP surface (webfinger/actor/inbox/outbox) when FEDERATION_ENABLED.
HTTP_PORT=8080
# Comma-separated allow-list of browser origins permitted to call the Connect edge
# cross-origin (ADR 0016 §6). Empty (default) means same-origin only. No effect on gRPC
# or the TUI.
# WEB_ORIGINS=http://localhost:5173

# Auth. Generate the Ed25519 signing keypair with: pnpm keys:generate
# (values are base64-encoded PEM: PKCS#8 private, SPKI public).
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
INVITE_ONLY=true
# Canonical domain of this node. Bound into every session and into the SSH login
# challenge blob, so a signature captured here cannot be replayed against another node.
NODE_DOMAIN=localhost
# Token lifetimes, in seconds (15 minutes / 30 days).
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000
# Argon2id cost. Defaults are the OWASP baseline (19 MiB, t=2, p=1); benchmark on the
# deployment hardware before raising them.
# ARGON2_MEMORY_KIB=19456
# ARGON2_TIME_COST=2
# ARGON2_PARALLELISM=1

# Amendment B social capabilities and limits (spec §184, §186, §190). These values are
# published by NodeService.GetNodeInfo so clients can render node policy honestly.
# DM_ENABLED=true
# DM_RETENTION_DAYS=0
# MAX_POST_CHARS=5000
# CAN_CREATE_COMMUNITY=false
# Comma-separated, width-1 glyph allow-list. Empty disables custom like glyphs.
# LIKE_GLYPH_ALLOW_LIST=

# GitHub OAuth device flow (P6-005, spec §167) — a credential, never an identity (§162+).
# Unset by default: BeginGitHubLogin/PollGitHubLogin answer UNIMPLEMENTED until a device
# flow-enabled OAuth App's client id is set here. Device flow must be explicitly enabled in
# the GitHub OAuth App's settings; see docs/architecture/auth.md §5.
# GITHUB_CLIENT_ID=
# Overridable so a local fake GitHub can be pointed at instead of the real
# github.com/api.github.com (only apps/server's own integration tests do this).
# GITHUB_DEVICE_CODE_URL=https://github.com/login/device/code
# GITHUB_TOKEN_URL=https://github.com/login/oauth/access_token
# GITHUB_USER_API_URL=https://api.github.com/user
# GITHUB_HTTP_TIMEOUT_MS=5000

# Email: console | smtp | resend
EMAIL_PROVIDER=smtp
EMAIL_FROM="Patches <no-reply@patches.local>"
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
RESEND_API_KEY=

# Object storage (Cloudflare R2 in prod; MinIO locally via `mise run compose -- up -d` —
# `minio`/`minio-init` are default-on, ADR 0015). R2_ACCOUNT_ID is R2-only (used to derive
# the account's endpoint); leave it unset for MinIO, which uses R2_ENDPOINT directly.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=patches
R2_SECRET_ACCESS_KEY=patchespatches
R2_BUCKET=patches-media
R2_ENDPOINT=http://127.0.0.1:9000
# MinIO needs path-style addressing; R2 also accepts it. Leave default unless pointed at a
# virtual-hosted-style-only S3 provider.
R2_FORCE_PATH_STYLE=true
R2_REGION=auto

# Media limits (spec §28) and presigned-URL lifetimes (spec §30, §32). Defaults shown.
# MEDIA_MAX_BYTES=10485760
# MEDIA_MAX_PIXELS=20000000
# MEDIA_PRESIGN_PUT_TTL_SECONDS=300
# MEDIA_PRESIGN_GET_TTL_SECONDS=600
# MEDIA_PENDING_UPLOAD_EXPIRY_MINUTES=60

# TUI (client)
PATCHES_SERVER=127.0.0.1:50051
PATCHES_INSECURE=true

# patches-admin CLI (spec §65) — talks to DATABASE_URL directly, never through the gRPC
# server. Default operator handle for --as; every mutating command still needs one or the
# other (docs/operations/moderation.md).
# PATCHES_ADMIN_OPERATOR=

# Phase 8 two-node federation lab (docs/architecture/federation.md). Default off — leave
# unset/false unless you're running the local federation lab. Gates only the federation
# HTTP surface (webfinger/actor/inbox/outbox), which is absent (not merely unrouted) when
# false — /healthz and the Connect edge listen on HTTP_PORT either way (ADR 0016 §4).
# FEDERATION_ENABLED=false
# AES-256-GCM key federation_keys.private_key_* is encrypted under (B-026). Required on both
# apps/server and apps/worker whenever FEDERATION_ENABLED=true on the server node — the
# worker needs the identical key to decrypt the same rows and sign outgoing deliveries.
# Generate with: openssl rand -base64 32
# FEDERATION_KEY_ENCRYPTION_KEY=

# Operator transparency (Amendment C, spec §197.6, §201.5) — published via
# NodeService.GetNodePolicy. All optional; an unset value renders as "this node publishes
# no policy" for that field rather than hiding the screen.
# NODE_POLICY_URL=https://example.com/privacy
# Moderator handles, comma-separated, joined into NodePolicy.moderator_contact.
# NODE_MODERATORS=
# disabled | allowlist | open-with-blocklist. Unset derives from FEDERATION_ENABLED
# (disabled when federation itself is off) rather than needing to keep two flags in sync.
# FEDERATION_STANCE=
# Operator-declared jurisdiction/provider, free text.
# DATA_LOCATION=
# Bumped by the operator when the (not-yet-configurable) privacy notice text changes.
# PRIVACY_NOTICE_VERSION=0
# Node-configurable appeal window, in days, from a moderation notice (spec §201.3, §204).
# APPEAL_WINDOW_DAYS=14
# Node-configurable account-deletion grace period, in days (spec §197.4, §204).
# ACCOUNT_DELETION_GRACE_PERIOD_DAYS=30
