{
  "name": "@patches/site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "sync-docs": "node scripts/sync-docs.mjs",
    "dev": "pnpm run sync-docs && vitepress dev . --port 5173",
    "build": "pnpm run sync-docs && vitepress build .",
    "preview": "vitepress preview .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "echo 'no tests for @patches/site' && exit 0",
    "clean": "rm -rf .vitepress/dist .vitepress/cache docs"
  },
  "devDependencies": {
    "vitepress": "catalog:"
  }
}
