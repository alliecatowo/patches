{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true
  },
  // The build configs are included so typescript-eslint's project service can
  // type-check them; without a tsconfig that owns them, ESLint reports a parsing
  // error. tsup builds from tsconfig.build.json, which excludes them.
  "include": ["src", "tsup.config.ts", "vitest.config.ts"]
}
