{
  "name": "@patches/proto",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./nest": {
      "types": "./dist/nest.d.ts",
      "import": "./dist/nest.js",
      "require": "./dist/nest.cjs"
    },
    "./es": {
      "types": "./dist/es.d.ts",
      "import": "./dist/es.js",
      "require": "./dist/es.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "proto"
  ],
  "scripts": {
    "gen": "buf generate && prettier --write src/generated src/generated-es",
    "lint:buf": "buf lint",
    "format:buf": "buf format -d --exit-code",
    "breaking": "./scripts/breaking.sh",
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "catalog:",
    "ts-proto": "catalog:",
    "tsup": "catalog:"
  },
  "dependencies": {
    "@bufbuild/protobuf": "catalog:",
    "@grpc/grpc-js": "catalog:",
    "@grpc/proto-loader": "catalog:",
    "@nestjs/microservices": "catalog:",
    "rxjs": "catalog:"
  }
}
