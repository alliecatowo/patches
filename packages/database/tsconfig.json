{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "types": ["node"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "noEmit": true,
    // tsup's dts build spawns tsc without a tsBuildInfoFile; the base config's
    // `incremental: true` makes that invocation fail (TS5074). Package-local override only.
    "incremental": false
  },
  // tsup.config.ts/vitest.config.ts/test included (alongside src) so ESLint's typed-linting
  // project service can resolve them — see packages/terminal-media/tsconfig.json for the
  // same pattern. `noEmit`/no `rootDir` avoids TS6059 for files outside src.
  "include": ["src", "test", "tsup.config.ts", "vitest.config.ts"]
}
