{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "types": ["node"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "noEmit": true,
    // tsup's dts build spawns tsc without a tsBuildInfoFile; the base config's
    // `incremental: true` makes that invocation fail (TS5074). Package-local override only.
    "incremental": false
  },
  // tsup.config.ts/vitest.config.ts are linted via eslint.config.js's
  // `allowDefaultProject: ['**/*.config.{ts,mts,cts}']` (B-005) rather than being
  // `include`d here — they aren't part of this package's actual TS program. `noEmit`/no
  // `rootDir` avoids TS6059 for files outside src.
  "include": ["src", "test"]
}
