{
  "name": "@patches/harness",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "patches-harness": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo"
  },
  "devDependencies": {
    "tsup": "catalog:"
  },
  "dependencies": {
    "@connectrpc/connect": "catalog:",
    "@connectrpc/connect-node": "catalog:",
    "@patches/client": "workspace:*",
    "@patches/proto": "workspace:*"
  }
}
