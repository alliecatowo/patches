{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "jsx": "react-jsx",
    "noEmit": true,
    // tsup's .d.ts worker invokes tsc without --tsBuildInfoFile, and `incremental`
    // (inherited from tsconfig.base.json) makes that fatal with TS5074.
    "incremental": false,
    "types": ["node"]
  },
  // tsup.config.ts/vitest.config.ts are linted via eslint.config.js's
  // `allowDefaultProject: ['**/*.config.{ts,mts,cts}']` (B-005) rather than being
  // `include`d here — they aren't part of this package's actual TS program.
  "include": ["src", "spike"]
}
