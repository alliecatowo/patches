{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "types": ["node"],
    "noEmit": true,
    // tsup's dts build spawns tsc without a tsBuildInfoFile; the base config's
    // `incremental: true` makes that invocation fail (TS5074). Package-local override only
    // (not touching tsconfig.base.json, which apps/other packages may still rely on).
    "incremental": false
  },
  // tsup.config.ts/vitest.config.ts included (alongside src) so ESLint's typed-linting
  // project service can resolve them — see packages/terminal-media/tsconfig.json for the
  // same pattern.
  "include": ["src", "tsup.config.ts", "vitest.config.ts"]
}
