{
  "name": "patches",
  "private": true,
  "version": "0.0.0",
  "description": "Terminal-native social media.",
  "license": "MIT",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11"
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@patches/server --filter=@patches/worker",
    "dev:tui": "pnpm --filter @patches/tui dev",
    "lint": "turbo run build && eslint . --cache --cache-location node_modules/.cache/eslint/",
    "lint:changed": "node scripts/lint-changed.mjs",
    "lint:fix": "turbo run build && eslint . --fix --cache --cache-location node_modules/.cache/eslint/",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:watch": "vitest",
    "test:integration": "vitest run --project database --project testkit --project '*-integration' --no-file-parallelism",
    "verify": "export PATCHES_WEB_ALLOW_LOCAL_BUILD=1 && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "proto:gen": "pnpm --filter @patches/proto gen",
    "proto:lint": "pnpm --filter @patches/proto lint:buf",
    "proto:format": "pnpm --filter @patches/proto format:buf",
    "proto:breaking": "pnpm --filter @patches/proto breaking",
    "db:migrate": "pnpm --filter @patches/database migration:run",
    "db:revert": "pnpm --filter @patches/database migration:revert",
    "db:generate": "pnpm --filter @patches/database migration:generate",
    "db:show": "pnpm --filter @patches/database migration:show",
    "keys:generate": "node apps/server/scripts/generate-keys.mjs",
    "opencode:config:validate": "node scripts/validate-opencode-config.mjs",
    "opencode:lsp:smoke": "node scripts/smoke-opencode-lsp.mjs",
    "server": "pnpm --filter @patches/server start:dev",
    "tui": "pnpm --filter @patches/tui start",
    "clean": "turbo run clean && rm -rf node_modules/.cache",
    "site:dev": "pnpm --filter @patches/site dev",
    "site:build": "pnpm --filter @patches/site build",
    "site:deploy": "pnpm --filter @patches/site build && pnpm exec wrangler pages deploy site/.vitepress/dist --project-name patches-site --branch main --commit-dirty=true"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@opentelemetry/auto-instrumentations-node": "catalog:",
    "@opentelemetry/exporter-prometheus": "catalog:",
    "@opentelemetry/exporter-trace-otlp-grpc": "catalog:",
    "@opentelemetry/exporter-trace-otlp-http": "catalog:",
    "@opentelemetry/instrumentation-grpc": "catalog:",
    "@opentelemetry/instrumentation-http": "catalog:",
    "@opentelemetry/instrumentation-nestjs-core": "catalog:",
    "@opentelemetry/instrumentation-pg": "catalog:",
    "@opentelemetry/resources": "catalog:",
    "@opentelemetry/sdk-metrics": "catalog:",
    "@opentelemetry/sdk-node": "catalog:",
    "@opentelemetry/sdk-trace-base": "catalog:",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "prom-client": "catalog:",
    "tsx": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
