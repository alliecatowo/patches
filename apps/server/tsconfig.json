{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // CommonJS output: NestJS 11 has no native ESM support
    // (docs/research/nestjs-grpc-protobuf.md §4). No "type":"module" in package.json.
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "noEmit": true
  },
  // vitest.config.mts/vitest.integration.config.mts are linted via eslint.config.js's
  // `allowDefaultProject: ['**/*.config.{ts,mts,cts}']` (B-005) rather than being
  // `include`d here — they aren't part of this package's actual TS program.
  "include": ["src", "test"]
}
