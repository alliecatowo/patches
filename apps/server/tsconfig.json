{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // CommonJS output: NestJS 11 has no native ESM support
    // (docs/research/nestjs-grpc-protobuf.md §4). No "type":"module" in package.json.
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "noEmit": true
  },
  "include": ["src", "test"]
}
