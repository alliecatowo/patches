    "@nestjs/core": "catalog:",
    "@nestjs/microservices": "catalog:",
    "@nestjs/typeorm": "catalog:",
    "@node-rs/argon2": "catalog:",
    "@patches/config": "workspace:*",
    "@patches/database": "workspace:*",
    "@patches/proto": "workspace:*",
    "grpc-health-check": "^2.1.0",
    "jose": "catalog:",
    "nodemailer": "catalog:",
    "pg": "catalog:",
    "reflect-metadata": "catalog:",
    "resend": "catalog:",
    "rxjs": "catalog:",
    "typeorm": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/cli": "catalog:",
