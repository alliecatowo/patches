{
  "name": "@patches/tui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "patches": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@grpc/grpc-js": "catalog:",
    "@grpc/proto-loader": "catalog:",
    "@inkjs/ui": "catalog:",
    "@patches/proto": "workspace:*",
    "@patches/terminal-media": "workspace:*",
    "ink": "catalog:",
    "react": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "ink-testing-library": "catalog:"
  }
}
