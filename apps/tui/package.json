{
  "name": "@patches/tui",
  "version": "0.1.0",
  "description": "Patches — terminal-native social media. Ink/React TUI client.",
  "license": "MIT",
  "private": false,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alliecatowo/patches.git",
    "directory": "apps/tui"
  },
  "homepage": "https://github.com/alliecatowo/patches",
  "keywords": [
    "cli",
    "tui",
    "terminal",
    "social",
    "ink",
    "patches"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "publishConfig": {
    "access": "public",
    "name": "patches-social"
  },
  "bin": {
    "patches": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && node scripts/copy-proto.mjs && chmod +x dist/cli.js",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@grpc/grpc-js": "catalog:",
    "@grpc/proto-loader": "catalog:",
    "@inkjs/ui": "catalog:",
    "@napi-rs/keyring": "catalog:",
    "ink": "catalog:",
    "react": "catalog:",
    "sharp": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@patches/domain": "workspace:*",
    "@patches/proto": "workspace:*",
    "@patches/terminal-media": "workspace:*",
    "@types/react": "catalog:",
    "ink-testing-library": "catalog:",
    "tsup": "catalog:"
  }
}
