    "expo-crypto": "catalog:",
    "expo-file-system": "catalog:",
    "expo-image-picker": "catalog:",
    "expo-secure-store": "catalog:",
    "expo-status-bar": "catalog:",
    "react": "catalog:",
    "react-native": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "babel-preset-expo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
