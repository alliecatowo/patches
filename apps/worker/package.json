{
  "name": "@patches/worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build -b swc -p tsconfig.build.json && find dist \\( -name \"*.test.js\" -o -name \"*.test.js.map\" \\) -delete",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "dev": "nest start --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --project worker-integration",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@nestjs/common": "catalog:",
    "@nestjs/config": "catalog:",
    "@nestjs/core": "catalog:",
    "@patches/config": "workspace:*",
    "@patches/database": "workspace:*",
    "@patches/domain": "workspace:*",
    "@patches/media": "workspace:*",
    "nodemailer": "catalog:",
    "pg": "catalog:",
    "reflect-metadata": "catalog:",
    "resend": "catalog:",
    "rxjs": "catalog:",
    "sharp": "catalog:",
    "tar-stream": "catalog:",
    "typeorm": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/cli": "catalog:",
    "@nestjs/testing": "catalog:",
    "@patches/testkit": "workspace:*",
    "@swc/cli": "catalog:",
    "@swc/core": "catalog:",
    "@types/nodemailer": "catalog:",
    "@types/pg": "catalog:",
    "@types/tar-stream": "catalog:",
    "unplugin-swc": "catalog:"
  }
}
