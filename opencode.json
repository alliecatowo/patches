{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [".opencode/rules/*.md"],
  "mcp": {
    "github": {
      "type": "remote",
      "enabled": true,
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer {env:GITHUB_PAT}",
        "X-MCP-Toolsets": "default,projects"
      }
    },
    "mise": {
      "type": "local",
      "command": ["mise", "mcp"],
      "enabled": true
    }
  },
  "lsp": {
    "typescript": {
      "command": ["typescript-language-server", "--stdio"],
      "extensions": [".ts", ".tsx", ".js", ".jsx", ".mjs", ".cjs", ".mts", ".cts"]
    }
  },
  "provider": {
    "llmgateway": {
      "models": {
        "grok-4-6": {
          "name": "Grok 4.6 (architect/auditor, standard tier, 200k cliff)",
          "limit": { "context": 180000, "output": 32000 }
        },
        "grok-4-3": {
          "name": "Grok 4.3 (cheap architect fallback, 200k cliff, 1M window)",
          "limit": { "context": 180000, "output": 32000 }
        },
        "gpt-5.6-luna": {
          "name": "GPT-5.6 Luna (driver, 272k cliff — bumped 150k→250k still cheap $0.20, 1M window)",
          "limit": { "context": 250000, "output": 16000 }
        },
        "gpt-5.6-terra": {
          "name": "GPT-5.6 Terra (senior/review, standard, 272k cliff)",
          "limit": { "context": 220000, "output": 32000 }
        },
        "gpt-5.6-sol": {
          "name": "GPT-5.6 Sol (EXCEPTIONAL only, PREMIUM, 272k cliff)",
          "limit": { "context": 250000, "output": 32000 }
        },
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash (default worker, standard, 1M — $0.05/$0.10 cheapest)",
          "limit": { "context": 250000, "output": 32000 }
        },
        "qwen3.7-flash": {
          "name": "Qwen 3.7 Flash (cheapest flash fallback, 1M — $0.03/$0.13)",
          "limit": { "context": 250000, "output": 16000 }
        },
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro (harder reasoning fallback, standard, 1M)",
          "limit": { "context": 250000, "output": 32000 }
        }
      }
    },
    "opencode": {
      "models": {
        "muse-spark-1.2-contributor-free": {
          "name": "Muse Spark 1.2 (FREE fallback worker)",
          "limit": { "context": 120000, "output": 16000 }
        },
        "nemotron-3-ultra-free": {
          "name": "Nemotron 3 Ultra (FREE fallback senior)",
          "limit": { "context": 140000, "output": 16000 }
        },
        "nemotron-3.5-lightning-free": {
          "name": "Nemotron 3.5 Lightning (FREE fast fallback)",
          "limit": { "context": 120000, "output": 16000 }
        },
        "mimo-v2.5-free": {
          "name": "Mimo V2.5 (FREE fallback)",
          "limit": { "context": 120000, "output": 16000 }
        }
      }
    }
  }
}
